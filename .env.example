# ==========================================================
# JQE Trading Platform — environment variable reference
# ==========================================================
# Copy this file to `.env` and fill in real values. `.env` is
# git-ignored; never commit real credentials.
#
# All variables are prefixed JQE_ and are matched case-
# insensitively. See config/settings.py for full documentation
# and validation rules for each field.

# --- Environment -------------------------------------------
JQE_ENVIRONMENT=development          # development | staging | production

# --- Broker selection ----------------------------------------
# Weltrade is the only supported broker.
JQE_BROKER=weltrade_demo            # weltrade | weltrade_demo
JQE_BROKER_EXECUTION_ENABLED=false  # explicit gate; do not enable by default
# All market data comes from the configured Weltrade MT5 terminal.
JQE_MARKET_DATA_SOURCE=broker
JQE_SIMULATION_DAILY_SUBMISSION_LIMIT=5
JQE_SIMULATION_DAILY_SUBMISSION_STORE_PATH=state/simulation_daily_submissions.sqlite3
JQE_OFFLINE_ANALYSIS_SEED=62061
JQE_OFFLINE_ANALYSIS_CANDLE_COUNT=500

# The observation daemon uses a separate portable terminal instance. The
# executable must live directly inside its exclusive portable data directory.
JQE_OBSERVATION_MT5_TERMINAL_PATH=D:\JQE\mt5-daemon-profile\terminal64.exe
JQE_OBSERVATION_MT5_PORTABLE_DATA_PATH=D:\JQE\mt5-daemon-profile

# --- Weltrade SyntX demo (credentials remain local; never commit values) ---
JQE_WELTRADE_TERMINAL_PATH=
JQE_WELTRADE_LOGIN=
JQE_WELTRADE_PASSWORD=
JQE_WELTRADE_SERVER=
JQE_MAX_DAILY_TRADES_PER_INSTRUMENT=20
JQE_DAILY_INSTRUMENT_TRADE_STORE_PATH=state/daily_instrument_trades.sqlite3


# --- Optional Telegram observability (disabled by default) -----
JQE_TELEGRAM_ENABLED=true
JQE_TELEGRAM_BOT_TOKEN=
JQE_TELEGRAM_ALLOWED_CHAT_ID=
JQE_TELEGRAM_SIGNAL_CHAT_ID=       # optional distinct signal/chart destination

# Continuous paper execution is disabled unless both settings explicitly opt in.
JQE_RUNTIME_MODE=enabled
JQE_PAPER_RUNTIME_ENABLED=true
JQE_PAPER_RUNTIME_POLL_SECONDS=60
JQE_PAPER_RUNTIME_MAX_BACKOFF_SECONDS=300
JQE_PAPER_RUNTIME_STATE_PATH=state/paper_runtime.sqlite3
JQE_PAPER_RUNTIME_INTENT_STORE_PATH=state/paper_runtime_intents.sqlite3
JQE_PAPER_DIAGNOSTICS_PATH=state/paper_diagnostics.sqlite3
JQE_PAPER_DIAGNOSTICS_MINIMUM_SAMPLE=100

# --- Trading defaults ----------------------------------------
JQE_DEFAULT_SYMBOL=FX Vol 20
JQE_DEFAULT_TIMEFRAME=M5
JQE_OBSERVATION_SYMBOLS=FX Vol 20:M1,FX Vol 20:M5,PainX 400:M1,PainX 400:M5
JQE_OBSERVATION_EVIDENCE_PATH=state/live_paper_operational/observation_daemon.evidence.sqlite3
JQE_OBSERVATION_CLOSE_GRACE_SECONDS=5
JQE_OBSERVATION_MAX_BACKOFF_SECONDS=300
JQE_OBSERVATION_HEARTBEAT_STALE_CYCLES=2
JQE_DEFAULT_CANDLE_COUNT=500

# --- Risk management -------------------------------------------
JQE_ACCOUNT_BALANCE=50
JQE_RISK_PERCENT=1.0
JQE_MAX_DAILY_LOSS=3.0
JQE_MAX_TRADES_DAILY=5

# --- Durable execution emergency stop --------------------------
# UNKNOWN and missing configuration fail closed. Only an explicit
# CLEAR passes this one policy gate; all other safety gates still apply.
JQE_EMERGENCY_STOP=ACTIVE           # CLEAR | ACTIVE | UNKNOWN

# --- Logging -----------------------------------------------------
JQE_LOG_LEVEL=INFO                   # TRACE|DEBUG|INFO|WARNING|ERROR|CRITICAL
JQE_LOG_DIR=logs
JQE_LOG_FILE=jqe.log
JQE_LOG_ROTATION=10 MB
JQE_LOG_RETENTION=14 days
JQE_LOG_TO_CONSOLE=true

# --- Data cache ----------------------------------------------------
JQE_CACHE_DIR=cache                  # SQLite historical-candle cache; see data/storage.py

# --- AI Assistant (Stateless, Read-Only Operator Intelligence) -----
JQE_AI_ASSISTANT_ENABLED=true
JQE_AI_ASSISTANT_KILL_SWITCH=true
JQE_AI_ASSISTANT_CONTEXT_MODE=generic
JQE_AI_ASSISTANT_PROVIDER=groq  # groq | anthropic | meta | openai_compatible
JQE_AI_ASSISTANT_MODEL=openai/gpt-oss-120b
JQE_AI_ASSISTANT_MAX_OUTPUT_TOKENS=2048
JQE_GROQ_REASONING_EFFORT=medium
# Generic mode sends only the question and generic instructions to the provider.
# Store the key locally in .env.ai; never commit it.
# JQE_GROQ_API_KEY=<set in .env.ai>
# JQE_GROQ_API_BASE=https://api.groq.com/openai/v1
