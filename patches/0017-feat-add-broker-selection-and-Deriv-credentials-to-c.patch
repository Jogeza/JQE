From 4a4cfc6bfda2574878d8bb77102695f4e55b5673 Mon Sep 17 00:00:00 2001
From: "JQE Chief Engineer (Claude)" <jqe-bot@example.com>
Date: Sun, 2 Aug 2026 17:09:23 +0000
Subject: [PATCH 17/37] feat: add broker selection and Deriv credentials to
 config
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

settings.broker (simulation | mt5 | deriv, default simulation) and
settings.deriv_api_token/deriv_app_id/deriv_endpoint. The token is
sourced from the environment/.env only — never hardcoded — per the
milestone's 'never expose API tokens in code' requirement.

Adds websockets and pytest-asyncio to requirements.txt.

Updates .env.example with JQE_BROKER and the JQE_DERIV_* variables.
---
 .env.example       | 14 ++++++++++++--
 config/settings.py | 17 +++++++++++++++++
 requirements.txt   |  4 ++++
 3 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/.env.example b/.env.example
index ddc08fa..031a7e9 100644
--- a/.env.example
+++ b/.env.example
@@ -11,12 +11,22 @@
 # --- Environment -------------------------------------------
 JQE_ENVIRONMENT=development          # development | staging | production
 
-# --- MT5 connection (optional — omit to use an already
-#     logged-in terminal instance) ---------------------------
+# --- Broker selection ----------------------------------------
+JQE_BROKER=simulation                # simulation | mt5 | deriv
+
+# --- MT5 connection (used when JQE_BROKER=mt5; optional — omit
+#     to use an already logged-in terminal instance) -----------
 JQE_MT5_LOGIN=
 JQE_MT5_PASSWORD=
 JQE_MT5_SERVER=
 
+# --- Deriv connection (used when JQE_BROKER=deriv) ---------------
+# Get a token at https://app.deriv.com/account/api-token — never
+# commit a real token.
+JQE_DERIV_API_TOKEN=
+JQE_DERIV_APP_ID=1089
+JQE_DERIV_ENDPOINT=wss://ws.derivws.com/websockets/v3
+
 # --- Trading defaults ----------------------------------------
 JQE_DEFAULT_SYMBOL=XAUUSD
 JQE_DEFAULT_TIMEFRAME=M5
diff --git a/config/settings.py b/config/settings.py
index 43c01bd..5109387 100644
--- a/config/settings.py
+++ b/config/settings.py
@@ -38,12 +38,23 @@ class Settings(BaseSettings):
         environment: Deployment environment. Affects logging verbosity
             and future environment-gated behavior (e.g. disabling live
             order routing outside of "production").
+        broker: Which :class:`~broker.base.BrokerGateway` implementation
+            :func:`broker.factory.get_gateway` constructs. Defaults to
+            ``"simulation"`` so the platform runs out of the box with
+            no credentials or live broker connection required.
         mt5_login: MetaTrader 5 account number used to authenticate with
             the terminal. ``None`` when using an already-logged-in
             terminal instance.
         mt5_password: MetaTrader 5 account password. Never logged.
         mt5_server: MetaTrader 5 broker server name (e.g.
             ``"ICMarketsSC-Demo"``).
+        deriv_api_token: Deriv API token, required when ``broker`` is
+            ``"deriv"``. Never logged; obtain from
+            https://app.deriv.com/account/api-token.
+        deriv_app_id: Deriv application ID. Defaults to Deriv's public
+            demo app ID (``"1089"``, used throughout their own docs) —
+            register your own for anything beyond development.
+        deriv_endpoint: Deriv WebSocket endpoint URL.
         default_symbol: Instrument symbol used when none is explicitly
             supplied to the trading pipeline.
         default_timeframe: MT5 timeframe name (e.g. ``"M5"``, ``"H1"``)
@@ -80,10 +91,16 @@ class Settings(BaseSettings):
 
     environment: Environment = "development"
 
+    broker: Literal["simulation", "mt5", "deriv"] = "simulation"
+
     mt5_login: int | None = None
     mt5_password: str | None = None
     mt5_server: str | None = None
 
+    deriv_api_token: str | None = None
+    deriv_app_id: str = "1089"
+    deriv_endpoint: str = "wss://ws.derivws.com/websockets/v3"
+
     default_symbol: str = "XAUUSD"
     default_timeframe: str = "M5"
     default_candle_count: int = Field(default=500, gt=0)
diff --git a/requirements.txt b/requirements.txt
index 59a71ca..16633e0 100644
--- a/requirements.txt
+++ b/requirements.txt
@@ -11,6 +11,9 @@
 # the test suite stubs this package on non-Windows platforms.
 MetaTrader5; sys_platform == "win32"
 
+# --- Broker connectivity -----------------------------------------
+websockets      # broker/deriv_gateway.py — Deriv's WebSocket API client
+
 # --- Data & numerical computing ----------------------------
 pandas
 numpy
@@ -38,6 +41,7 @@ alembic
 
 # --- Testing & tooling --------------------------------------------
 pytest
+pytest-asyncio   # broker/ tests use async def test_... directly
 pytest-cov
 black
 ruff
